# [!NOTE]
# Read the `docs/configuration_guide.md` carefully, and update the
# configurations to match your specific settings and requirements.
# - Replace `api_key` with your own credentials.
# - Replace `base_url` and `model` name if you want to use a custom model.
# - Set `verify_ssl` to `false` if your LLM server uses self-signed certificates
# - A restart is required every time you change the `conf.yaml` file.

# Default: Google Gemini models via Google AI Studio
# Get your API key from https://aistudio.google.com/app/apikey
BASIC_MODEL:
  platform: "google_aistudio"
  model: "gemini-2.0-flash-lite"  # Fast and cost-effective model for general tasks
  api_key: your_gemini_api_key
  max_retries: 3
  # token_limit: 180000 # Maximum input tokens for context compression

REASONING_MODEL:
  platform: "google_aistudio"
  model: "gemini-2.0-flash"  # More capable model for planning and reasoning
  api_key: your_gemini_api_key
  max_retries: 3
  # token_limit: 180000

CODE_MODEL:
  platform: "google_aistudio"
  model: "gemini-2.0-flash"  # For code analysis and generation
  api_key: your_gemini_api_key
  max_retries: 3

# Alternative model configurations:

# Ollama (Tested and supported for local development)
# BASIC_MODEL:
#   base_url: "http://localhost:11434/v1"  # Ollama OpenAI compatible endpoint
#   model: "qwen3:14b"  # or "llama3.2", etc.
#   api_key: "ollama"  # Ollama doesn't need real API key
#   max_retries: 3
#   verify_ssl: false  # Local deployment usually doesn't need SSL verification

# Bytedance Doubao
# BASIC_MODEL:
#   base_url: https://ark.cn-beijing.volces.com/api/v3
#   model: "doubao-1-5-pro-32k-250115"
#   api_key: xxxx
#   max_retries: 3
#   token_limit: 200000

# OpenAI GPT-4o
# BASIC_MODEL:
#   base_url: https://api.openai.com/v1
#   model: "gpt-4o"
#   api_key: sk-xxx
#   max_retries: 3

# DeepSeek
# BASIC_MODEL:
#   base_url: https://api.deepseek.com
#   model: "deepseek-chat"
#   api_key: xxx


# OTHER SETTINGS:

# Tool-specific interrupts configuration (Issue #572)
# Allows interrupting execution before specific tools are called.
# Useful for reviewing sensitive operations like database queries or API calls.
# Note: This can be overridden per-request via the API.
# TOOL_INTERRUPTS:
#   # List of tool names to interrupt before execution
#   # Example: interrupt before database tools or sensitive API calls
#   interrupt_before: 
#     - "db_tool"           # Database operations
#     - "db_read_tool"      # Database reads
#     - "db_write_tool"     # Database writes
#     - "payment_api"       # Payment-related API calls
#     - "admin_api"         # Administrative API calls
#   # When interrupt is triggered, user will be prompted to approve/reject
#   # Approved keywords: "approved", "approve", "yes", "proceed", "continue", "ok", "okay", "accepted", "accept"

# Web search toggle (Issue #681)
# Set to false to disable web search and use only local RAG knowledge base.
# This is useful for environments without internet access.
# WARNING: If you disable web search, make sure to configure local RAG resources;
#          otherwise, the researcher will operate in pure LLM reasoning mode without external data.
# Note: This can be overridden per-request via the API parameter `enable_web_search`.
# ENABLE_WEB_SEARCH: true

# Search engine configuration
# Default: Serper + Firecrawl combined search (recommended)
# This uses Serper for Google search and Firecrawl for content scraping
SEARCH_ENGINE:
  engine: serper_firecrawl
  # Number of top search results to scrape (1, 3, 5, or 10)
  top_k: 3
  # Include images in search results
  include_images: true
  # Country code for search (us, uk, cn, etc.)
  gl: us
  # Language code for search (en, zh, etc.)
  hl: en
  # Firecrawl settings
  firecrawl_timeout: 30000  # Timeout in milliseconds
  firecrawl_only_main_content: true  # Extract only main content
  firecrawl_remove_base64_images: true  # Remove base64 images
  firecrawl_block_ads: true  # Block ads
  firecrawl_wait_for: 0  # Wait time before scraping (ms)
  max_workers: 3  # Parallel scraping workers

# Alternative search engines:

# Tavily (AI-optimized search)
# SEARCH_ENGINE:
#   engine: tavily
#   include_domains: []
#   exclude_domains: []
#   include_answer: false
#   search_depth: "advanced"
#   include_raw_content: true
#   include_images: true
#   include_image_descriptions: true

# Serper only (without Firecrawl content scraping)
# SEARCH_ENGINE:
#   engine: serper

# DuckDuckGo (no API key required)
# SEARCH_ENGINE:
#   engine: duckduckgo

# Brave Search
# SEARCH_ENGINE:
#   engine: brave_search


# Crawler engine configuration
# Default: Firecrawl (recommended for LLM-optimized content)
CRAWLER_ENGINE:
  engine: firecrawl
  timeout: 30000  # Timeout in milliseconds
  only_main_content: true  # Extract only main content
  remove_base64_images: true  # Remove base64 images
  block_ads: true  # Block ads
  wait_for: 0  # Wait time before scraping (ms)

# Alternative crawler engines:

# Jina (simple, free tier available)
# CRAWLER_ENGINE:
#   engine: jina

# InfoQuest (BytePlus product)
# CRAWLER_ENGINE:
#   engine: infoquest
#   fetch_time: 10
#   timeout: 30
#   navi_timeout: 15